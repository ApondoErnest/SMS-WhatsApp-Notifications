# Visite Notify — Docker production env
# Copy to .env.docker on the VPS and fill secrets:
#   cp .env.docker.example .env.docker

# --- Compose / host bind ---
DOCKER_HTTP_PORT=8084

# --- Application ---
APP_NAME="Visite Notify"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://notify.noblevehicletestingcompany.com
APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (Docker service hostname = mysql) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=visite_notify
DB_USERNAME=visite_notify
DB_PASSWORD=change-me-strong-db-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# --- Session / Cache / Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Redis (Docker service hostname = redis) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noblevehicletestingcompany.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# --- Nexah Bulk SMS ---
NEXAH_SMS_USER=
NEXAH_SMS_PASSWORD=
NEXAH_SMS_SENDER_ID=
NEXAH_SMS_BASE_URL=https://smsvas.com/bulk/public/index.php/api/v1
NEXAH_SMS_WEBHOOK_TOKEN=

# --- Meta WhatsApp (leave blank / disabled for now) ---
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_DEFAULT_TEMPLATE=visite_expiry_reminder
META_WHATSAPP_DEFAULT_LANGUAGE=fr
META_WHATSAPP_RATE_UTILITY=0.004
META_WHATSAPP_RATE_MARKETING=0.025
META_WHATSAPP_RATE_AUTHENTICATION=0.004
META_WHATSAPP_RATE_SERVICE=0

DEFAULT_PHONE_COUNTRY=CM

CSV_MAX_FILE_SIZE_MB=64
CSV_MAX_ROWS=250000
CSV_INSERT_CHUNK_SIZE=500
CSV_MAX_ERROR_LOG_ENTRIES=1000
CSV_PROGRESS_EVERY=1000
CSV_SCHEDULE_CHUNK_SIZE=200

DEFAULT_REMINDER_DAYS=30,14,7,1
NOTIFICATIONS_SENDING_ENABLED=false
NOTIFICATIONS_SEND_WINDOW_START=08:00
NOTIFICATIONS_SEND_WINDOW_END=19:00
SMS_SENDING_ENABLED=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60
DB_BACKUP_ENABLED=true
DB_BACKUP_DISK=local
DB_BACKUP_PATH=backups/database
DB_BACKUP_RETAIN=14

HORIZON_PATH=horizon
VITE_APP_NAME="${APP_NAME}"
