# =============================================================================
# Visite Notify — Environment Configuration
# Copy to .env and adjust values: cp .env.example .env
# =============================================================================

# --- Application ---
APP_NAME="Visite Notify"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=visite_notify
DB_USERNAME=root
DB_PASSWORD=

# --- Session / Cache / Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@visite-notify.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Filesystem ---
FILESYSTEM_DISK=local

# --- Nexah Bulk SMS (https://nexah.net/) ---
# Give Nexah this DLR callback URL in production: {APP_URL}/webhooks/nexah/sms
NEXAH_SMS_USER=your_nexah_username
NEXAH_SMS_PASSWORD=your_nexah_password
NEXAH_SMS_SENDER_ID=your_sender_id
NEXAH_SMS_BASE_URL=https://smsvas.com/bulk/public/index.php/api/v1

# --- Meta WhatsApp Cloud API (direct — no Twilio) ---
META_WHATSAPP_TOKEN=your_meta_access_token
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
META_WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
META_WHATSAPP_API_VERSION=v21.0
META_WHATSAPP_DEFAULT_TEMPLATE=visite_expiry_reminder
META_WHATSAPP_DEFAULT_LANGUAGE=fr
META_WHATSAPP_RATE_UTILITY=0.004
META_WHATSAPP_RATE_MARKETING=0.025
META_WHATSAPP_RATE_AUTHENTICATION=0.004
META_WHATSAPP_RATE_SERVICE=0

# --- Phone normalization ---
DEFAULT_PHONE_COUNTRY=CM

# --- CSV import limits (harden for large daily files) ---
CSV_MAX_FILE_SIZE_MB=64
CSV_MAX_ROWS=250000
CSV_INSERT_CHUNK_SIZE=500
CSV_MAX_ERROR_LOG_ENTRIES=1000
CSV_PROGRESS_EVERY=1000
CSV_SCHEDULE_CHUNK_SIZE=200

# --- Notification defaults ---
DEFAULT_REMINDER_DAYS=30,14,7,1
NOTIFICATIONS_SENDING_ENABLED=false
NOTIFICATIONS_SEND_WINDOW_START=08:00
NOTIFICATIONS_SEND_WINDOW_END=19:00
SMS_SENDING_ENABLED=false

# --- Horizon ---
HORIZON_PATH=horizon

# --- Vite ---
VITE_APP_NAME="${APP_NAME}"
