# Modest defaults for a shared Hostinger VPS (Visite Notify only).
# Mounted read-only into mysql:8.4 at /etc/mysql/conf.d/visite-notify.cnf

[mysqld]
# ~256–384M InnoDB buffer is enough for multi-center reminder data on a small VPS.
innodb_buffer_pool_size = 256M
innodb_log_file_size = 64M
innodb_flush_method = O_DIRECT
innodb_flush_log_at_trx_commit = 2

max_connections = 80
table_open_cache = 400
tmp_table_size = 32M
max_heap_table_size = 32M

slow_query_log = ON
long_query_time = 2
log_queries_not_using_indexes = OFF

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

[client]
default-character-set = utf8mb4
